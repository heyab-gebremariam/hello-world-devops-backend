
data "external_schema" "gorm" {
  program = [
    "go",
    "run",
    "./atlas/main.go",
  ]
}

env "gorm" {
  src = data.external_schema.gorm.url
  dev = "postgres://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME?sslmode=DB_SSLMODE&search_path=public"

  migration {
    dir = "file://migrations"
  }

  format {
    migrate {
      diff = "{{ sql . \"  \" }}"
    }
  }
}


